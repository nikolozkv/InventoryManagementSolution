@model InventoryManagementWebApp.Models.Barrel

@{
    ViewData["Title"] = "❌ კასრის წაშლა";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>ყურადღება!</h4>
                    <p class="mb-0">@TempData["ErrorMessage"]</p>
                </div>
            }

            <div class="card shadow-lg border-0 border-top border-danger border-5">
                <div class="card-body text-center p-5">
                    <div class="text-danger mb-4">
                        <i class="bi bi-exclamation-octagon-fill" style="font-size: 4.5rem;"></i>
                    </div>
                    <h2 class="card-title fw-bold text-danger mb-3">კასრის წაშლა</h2>
                    <p class="card-text fs-5 mb-4">
                        დარწმუნებული ხართ, რომ გსურთ ამ კასრის <strong>ამოშლა</strong> ძირითადი ბაზიდან?
                        <br />
                        <span class="text-muted small mt-2 d-block">
                            <i class="bi bi-shield-lock-fill"></i> აღდგენა შესაძლებელია მხოლოდ ბაზის ადმინისტრატორის მიერ!
                        </span>
                    </p>

                    <div class="bg-light p-4 rounded mb-4 text-start border border-danger border-opacity-25">
                        <p class="mb-2 text-secondary small text-uppercase fw-bold">კასრის მონაცემები:</p>
                        <p class="mb-1 fs-5"><strong>სასმელი:</strong> @Model.Beverage?.Name</p>
                        <p class="mb-1"><strong>წელი:</strong> @(Model.Year == 0 ? "წლოვანების გარეშე" : Model.Year.ToString())</p>
                        <p class="mb-0"><strong>ნაშთი:</strong> <span class="badge bg-dark">@Model.CurrentVolume ლ</span></p>
                    </div>

                    <form asp-action="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BarrelID" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger btn-lg px-4">
                                <i class="bi bi-trash"></i> კი, წაშალე
                            </button>
                            <a asp-action="Edit" asp-route-id="@Model.BarrelID" class="btn btn-secondary btn-lg px-4">
                                გაუქმება
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>